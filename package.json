{
  "name": "prediction-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wallet-native binary prediction markets on Robinhood Chain",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:chain": "anvil --chain-id 46630 --port 8545",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run && turbo test",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "contracts:local": "pnpm --filter @pl/contracts run local:deploy",
    "db:generate": "pnpm --filter @pl/database run generate",
    "db:migrate": "pnpm --filter @pl/database run migrate",
    "seed": "pnpm --filter @pl/database run seed",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@pl/sdk": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "viem": "2.56.3",
    "vitest": "5.0.0"
  }
}
