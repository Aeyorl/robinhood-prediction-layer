# Placeholders only — copy to .env and fill in real values.

# Chain this worker indexes: 4663 (mainnet), 46630 (testnet)
CHAIN_ID=46630

# WebSocket RPC (preferred) with HTTP fallback
RPC_WS_URL=wss://rpc.testnet.chain.robinhood.com
RPC_HTTP_URL=https://rpc.testnet.chain.robinhood.com

# Start indexing from this block (backfill start). Set to 0 to backfill from
# the MarketFactory deployment block (binary-searched) on first run.
START_BLOCK=0

# MarketFactory the indexer watches for MarketCreated events.
# Local: read "factory" from packages/contracts/deployments/local.json
# (written by `pnpm contracts:local`).
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# PostgreSQL + Redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prediction
REDIS_URL=redis://localhost:6379

# Poll interval for HTTP fallback / reconciliation (ms)
HTTP_POLL_INTERVAL_MS=4000