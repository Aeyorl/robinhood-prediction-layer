# Placeholders only — copy to .env.local and fill in real values.

# Chain to operate on locally: 4663 (mainnet), 46630 (testnet)
NEXT_PUBLIC_CHAIN_ID=46630

# WalletConnect Project ID (required only if you enable the WalletConnect connector)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public RPC overrides (optional; defaults come from @pl/chain-config)
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_TESTNET=

# API base URL used by the web app
NEXT_PUBLIC_API_URL=http://localhost:3001