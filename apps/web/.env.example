[TEMPLATE]
# Placeholders only — copy to .env.local and fill in real values.

# Chain to operate on: 4663 (mainnet), 46630 (testnet)
NEXT_PUBLIC_CHAIN_ID=46630

# Local chain mode — point the web app + wallet at an anvil instance on
# 127.0.0.1:8545 running with the same chain id (pnpm dev:chain). Markets and
# pools are then read live from that local deployment (pnpm contracts:local).
# NEVER set this for real networks.
NEXT_PUBLIC_LOCAL_CHAIN=false

# Public RPC overrides (optional; defaults come from @pl/chain-config).
# In local mode NEXT_PUBLIC_RPC_TESTNET is ignored in favour of 127.0.0.1:8545.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_TESTNET=

# Optional: absolute path to the local deployment manifest (defaults to
# <repo>/packages/contracts/deployments/local.json via cwd/import.meta).
PL_LOCAL_MANIFEST=

# API base URL used by the web app
NEXT_PUBLIC_API_URL=http://localhost:3001

# WalletConnect Project ID (required only if you enable the WalletConnect connector)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Poku protocol contract address
NEXT_PUBLIC_POKU_CONTRACT_ADDRESS=0x99f207cb270191ecf700c16b5c6fe116e007e0b8
