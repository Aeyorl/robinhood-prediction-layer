# Placeholders only — copy to .env and fill in real values.

# Port to listen on
PORT=3001

# CORS origin for the web app
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prediction

# Redis
REDIS_URL=redis://localhost:6379

# Chain this API instance serves: 4663 (mainnet), 46630 (testnet)
CHAIN_ID=46630

# Funding layer. Export these variables, or start tsx with --env-file=.env.
RPC_HTTP_URL=http://127.0.0.1:8545
SWAP_ADAPTER=mock
# Copy actual addresses from packages/contracts/deployments/local.json:
# USDG_ADDRESS=<usdg>
# MOCK_SWAP_ADAPTER_ADDRESS=<mockSwapAdapter>
# KNOWN_TOKEN_ADDRESSES=<mocks.PONS.address>,<mocks.DELTA.address>,<mocks.AI.address>
BLOCKED_TOKEN_ADDRESSES=
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_BPS=300
QUOTE_TTL_SECONDS=60
MAX_QUOTED_ASSETS_PER_REQUEST=10
# Optional raw-unit override; omitted defaults to 0.01 USDG using onchain decimals.
# DUST_THRESHOLD_USDG=10000

# Mainnet/fork only; keep secrets on the API server.
# UNISWAP_API_KEY=
UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
# Optional override; the built-in allowlist contains Uniswap's current and immutable legacy proxies.
# UNISWAP_PROXY_ADDRESS=0x0000000085E102724e78eCd2F45DC9cA239Affad
