# Placeholders only — copy to .env and fill in real values.

# Port to listen on
PORT=3001

# CORS origin for the web app
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prediction

# Redis
REDIS_URL=redis://localhost:6379

# Chain this API instance serves: 4663 (mainnet), 46630 (testnet)
CHAIN_ID=46630