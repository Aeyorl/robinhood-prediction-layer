{
  "name": "@pl/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations, and client for PostgreSQL",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
