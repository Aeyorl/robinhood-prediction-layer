{
  "name": "@pl/chain-config",
  "version": "0.1.0",
  "private": true,
  "description": "Robinhood Chain configuration: chains, RPCs, addresses, contract config",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:oracles": "pnpm build && node scripts/verify-oracles.mjs"
  },
  "dependencies": {
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
