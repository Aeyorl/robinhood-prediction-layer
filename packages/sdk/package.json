{
  "name": "@pl/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Client SDK: payout math, ABIs, call helpers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pl/chain-config": "workspace:*",
    "@pl/contracts": "workspace:*",
    "@pl/types": "workspace:*",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
